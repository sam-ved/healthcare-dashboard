// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Patient {
  id        Int           @id @default(autoincrement())
  name      String
  age       Int
  issue     String
  since     String
  status    WorkflowStatus @default(WAITING)
  createdAt DateTime      @default(now())

  // Extended hospital fields
  pid        String   @unique
  fullName   String
  gender     String
  dob        DateTime
  phone      String   @unique
  address    String
  bloodGroup String
  allergies  String?
  weight     Int      // Mandatory
  height     Int      // Mandatory (in cm)

  // Workflow fields
  assignedDoctorId       Int?
  prescription           String?
  isSurgeryRequired      Boolean @default(false)
  isAdmissionRecommended Boolean @default(false)

  // Relations
  assignedDoctor Employee? @relation("PatientToDoctor", fields: [assignedDoctorId], references: [id])
  visits         Visit[]
  surgeries      Surgery[]
}

enum PatientStatus {
  ADMITTED
  DISCHARGED
}

// Workflow status for the 3-tier system
enum WorkflowStatus {
  WAITING
  CONSULTED
  ADMITTED
  DISCHARGED
}

// Employee roles in hospital
enum Role {
  ADMIN
  DOCTOR
  NURSE
  WARDBOY
  RECEPTIONIST
}

// Visit status for patient visits/admissions
enum VisitStatus {
  CHECKUP_PENDING
  ADMITTED
  DISCHARGED
  SURGERY_SCHEDULED
  IN_SURGERY
  UNDER_OBSERVATION
}

// Types of wards
enum WardType {
  GENERAL
  ICU
  PRIVATE
}

model Employee {
  id         Int      @id @default(autoincrement())
  employeeId String   @unique @default(uuid())
  password   String
  role       Role
  fullName   String
  mobile     String   @unique
  email      String   @unique
  available  Boolean  @default(true)
  department String?
  createdAt  DateTime @default(now())

  // Relations
  visits              Visit[]
  surgeries           Surgery[]
  assignedPatients    Patient[] @relation("PatientToDoctor")
}

model Visit {
  id           Int          @id @default(autoincrement())
  patientId    Int
  doctorId     Int
  visitReason  String
  status       VisitStatus  @default(CHECKUP_PENDING)
  assignedWard WardType?
  diagnosis    String?
  prescription String?
  notes        String?
  visitDate    DateTime     @default(now())
  dischargedAt DateTime?

  patient Patient @relation(fields: [patientId], references: [id])
  doctor  Employee @relation(fields: [doctorId], references: [id])
}

model Surgery {
  id          Int      @id @default(autoincrement())
  patientId   Int
  doctorId    Int
  surgeryType String
  scheduledFor DateTime
  status      String
  createdAt   DateTime @default(now())

  patient Patient  @relation(fields: [patientId], references: [id])
  doctor  Employee @relation(fields: [doctorId], references: [id])
}